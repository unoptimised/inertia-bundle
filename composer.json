{
    "name": "unoptimised/inertia-bundle",
    "description": "A Symfony bundle for Inertia.js",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Unoptimised\\InertiaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unoptimised\\InertiaBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/config": "^6.4|^7.4",
        "symfony/dependency-injection": "^6.4|^7.4",
        "symfony/http-foundation": "^6.4|^7.4",
        "symfony/http-kernel": "^6.4|^7.4",
        "symfony/twig-bundle": "^6.4|^7.4",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^13",
        "symfony/filesystem": "^6.4|^7.4",
        "symfony/framework-bundle": "^6.4|^7.4",
        "symfony/property-access": "^6.4|^7.4",
        "symfony/property-info": "^6.4|^7.4",
        "symfony/serializer": "^6.4|^7.4"
    },
    "suggest": {
        "symfony/serializer": "Normalise object props (entities, DTOs) instead of relying on plain json_encode"
    },
    "config": {
        "sort-packages": true
    }
}
